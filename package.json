{
  "name": "hal9000",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "mobile": "npm run start --workspace=@wildcard/mobile",
    "mobile:ios": "npm run ios --workspace=@wildcard/mobile",
    "mobile:android": "npm run android --workspace=@wildcard/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@wildcard/mobile",
    "mobile:test": "npm run test --workspace=@wildcard/mobile",
    "dev": "set -a; . ./.env.local; set +a; npm run dev --workspace=@wildcard/web",
    "build": "set -a; . ./.env.local; set +a; npm run build --workspace=@wildcard/web",
    "lint": "npm run lint --workspace=@wildcard/web",
    "typecheck": "npm run typecheck --workspace=@wildcard/web"
  }
}
